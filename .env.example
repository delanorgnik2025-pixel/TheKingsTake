# ============================================
# #TheKingsTake — Environment Variables
# ============================================
# DO NOT put real values in this file.
# This is just a REFERENCE.
#
# When deploying to Railway:
# 1. Go to Railway Dashboard → Your Project → Variables
# 2. Add each variable with its real value
# ============================================

# --- Already Set (Don't Change) ---
# DATABASE_URL=          # Auto-provided by Railway MySQL
# VITE_APP_ID=           # Auto-generated by init
# VITE_KIMI_AUTH_URL=    # Auto-generated by init
# KIMI_AUTH_URL=         # Auto-generated by init
# APP_SECRET=            # Auto-generated by init
# OWNER_UNION_ID=        # Auto-generated by init

# --- YOUR Business Accounts (Add When Ready) ---
# Stripe (for payments) — Get from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# OpenAI / ChatGPT (for AI legal forms) — Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Google AI (alternative AI) — Get from https://ai.google.dev
# GOOGLE_AI_API_KEY=...

# Eleven Labs (for voice synthesis) — Get from https://elevenlabs.io/app/settings/api-keys
# ELEVEN_LABS_API_KEY=sk_...

# You have this already — just paste it in Railway when ready

# --- Email delivery and private owner alerts (Resend) ---
# RESEND_API_KEY=re_...
# OWNER_NOTIFICATION_EMAIL=you@example.com
# NEWSLETTER_FROM_EMAIL=The Kings Take <updates@updates.thekingstake.com>
# PUBLIC_SITE_URL=https://thekingstake.com
# VISITOR_ALERTS_ENABLED=true
# VISITOR_ALERT_COOLDOWN_SECONDS=60

# --- Public archive search (keep keys server-side) ---
# NARA_API_KEY=...

# --- Feed owner identity ---
# OWNER_MEMBER_EMAIL=you@example.com
# OWNER_DISPLAY_NAME=Ronald Lee King

# --- Optional licensed site soundtrack URL ---
# VITE_SITE_AUDIO_URL=https://your-cdn.example.com/licensed-track.mp3
